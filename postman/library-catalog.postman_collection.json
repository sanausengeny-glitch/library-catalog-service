              "raw": "{\n  \"title\": \"Dune\",\n  \"author\": \"Frank Herbert\",\n  \"isbn\": \"978-0441172719\",\n  \"description\": \"Updated summary.\",\n  \"coverImage\": \"https://example.com/dune-updated.jpg\",\n  \"totalCopies\": 12,\n  \"availableCopies\": 8,\n  \"genre\": \"{{genreId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["books", "{{bookId}}"]
