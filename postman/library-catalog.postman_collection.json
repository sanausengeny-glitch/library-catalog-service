    {
      "name": "Books",
      "item": [
        {
          "name": "GET /books",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?genre={{genreId}}&search=dune&page=2&limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                {
                  "key": "genre",
                  "value": "{{genreId}}"
                },
                {
                  "key": "search",
                  "value": "dune"
                },
                {
                  "key": "page",
                  "value": "2"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET /books/:id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["books", "{{bookId}}"]
            }
          },
          "response": []
        },
        {
          "name": "POST /books",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Dune\",\n  \"author\": \"Frank Herbert\",\n  \"isbn\": \"978-0441172719\",\n  \"description\": \"A sci-fi epic about politics, religion, and survival.\",\n  \"coverImage\": \"https://example.com/dune.jpg\",\n  \"totalCopies\": 10,\n  \"availableCopies\": 7,\n  \"genre\": \"{{genreId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            }
          },
          "response": [
            {
              "name": "400 validation error example",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{}"
                },
                "url": {
                  "raw": "{{baseUrl}}/books",
                  "host": ["{{baseUrl}}"],
                  "path": ["books"]
                }
              },
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"success\": false,\n  \"error\": {\n    \"field\": \"title\",\n    \"message\": \"title is required.\"\n  }\n}",
              "_postman_previewlanguage": "json"
            }
          ]
        },
